{
  "Reset vector block": {
    "prefix": "vectors",
    "body": [
      ".segment \"VECTORS\"",
      "        .word   ${1:nmi_handler}        ; NMI   (\\$FFFA)",
      "        .word   ${2:reset}              ; RESET (\\$FFFC)",
      "        .word   ${3:irq_handler}        ; IRQ   (\\$FFFE)",
      "$0"
    ],
    "description": "Standard 6502 reset/NMI/IRQ vector block."
  },
  "Procedure": {
    "prefix": "proc",
    "body": [
      ".proc ${1:name}",
      "        $0",
      ".endproc"
    ],
    "description": "ca65 .proc / .endproc block."
  },
  "Conditional assembly": {
    "prefix": "ifdef",
    "body": [
      ".ifdef ${1:SYMBOL}",
      "        $0",
      ".endif"
    ],
    "description": ".ifdef / .endif block."
  },
  "Halt loop": {
    "prefix": "halt",
    "body": [
      "halt:   jmp     halt            ; spin (debugger sees Halted=true)"
    ],
    "description": "Self-jump halt — chippy reports Halted=true."
  },
  "Apple-1 putc": {
    "prefix": "putc",
    "body": [
      "        sta     \\$F001          ; Apple-1-style TextOutput"
    ],
    "description": "Write A to $F001 (chippy's TextOutput peripheral)."
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ca65 / 6502 assembly",
  "scopeName": "source.asm.ca65",
  "fileTypes": ["s", "s65", "asm", "inc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#mnemonics-65c02" },
    { "include": "#mnemonics-nmos" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#registers" },
    { "include": "#labels" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.ca65",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.ca65",
          "match": "(?i)\\.(?:segment|byte|word|dword|asciiz|asciz|res|align|org|proc|endproc|scope|endscope|macro|endmacro|if|ifdef|ifndef|else|elseif|endif|import|importzp|export|exportzp|global|globalzp|zeropage|bss|data|code|rodata|setcpu|p02|pc02|p816|debuginfo|dbg|incbin|include|out|repeat|endrep|enum|endenum|struct|endstruct|union|endunion|tag|sizeof|local|smart|listbytes|feature|interruptor|condes|forceimport|forceword)\\b"
        }
      ]
    },
    "mnemonics-nmos": {
      "patterns": [
        {
          "name": "keyword.mnemonic.nmos.ca65",
          "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)\\b"
        }
      ]
    },
    "mnemonics-65c02": {
      "patterns": [
        {
          "name": "keyword.mnemonic.cmos.ca65",
          "match": "(?i)\\b(bbr[0-7]|bbs[0-7]|bra|dea|ina|phx|phy|plx|ply|rmb[0-7]|smb[0-7]|stp|stz|trb|tsb|wai)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.ca65",
          "match": "(?i)\\b[axy]\\b(?=\\s*[,)])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ca65",
          "match": "\\$[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.ca65",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.hex.c.ca65",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.ca65",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ca65",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ca65",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ca65",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ca65",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.ca65",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.address.ca65",
          "match": "[<>#@]"
        },
        {
          "name": "keyword.operator.arithmetic.ca65",
          "match": "[+\\-*/&|^~]"
        }
      ]
    }
  }
}

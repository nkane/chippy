# Build artifacts (binary at repo root only, not the cmd/chippy package)
/chippy
*.bin
*.o
*.dbg
*.prg
*.hex
*.lst
*.map

# Canned demos shipped with the WASM playground — small, stable, version-controlled
# so `make -C web serve` works without re-building the example/ ROMs from source.
!web/demos/*.bin


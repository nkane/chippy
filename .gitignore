# Build artifacts (binary at repo root only, not the cmd/chippy package)
/chippy
/nessy
*.bin
*.o
*.dbg
*.prg
*.hex
*.lst
*.map

# Canned demos shipped with the WASM playground — small, stable, version-controlled
# so `make -C web serve` works without re-building the example/ ROMs from source.
!web/demos/*.bin

# nessy demo ROMs — built artifacts committed so `nessy game.nes` and the
# nessy-side source-view (-dap-attach) work without rebuilding from ca65.
!roms/demos/*/*.nes
!roms/demos/*/*.dbg

# VHS smoke-test renders (generated on demand, never committed).
test/smoke/out/

# MkDocs build output
site/
_site/

# Local state
.chippy/
~/.chippy/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
